---
// The top bar shown on every page: logo (left) + Docs / GitHub (right),
// contents centered in a max-width container that lines up with page content.
//
// On the homepage the bar is hidden and only slides in after the visitor has
// scrolled past the hero (~500px). Pass `revealOnScroll` to enable that; every
// other page keeps the bar pinned and always visible.
// `trailingSlash: 'never'` strips BASE_URL's trailing slash, so normalize to
// exactly one slash before the `${base}…` concatenations below resolve.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const repo = 'https://github.com/dunky-dev/state-machine'

interface Props {
  revealOnScroll?: boolean
}
const { revealOnScroll = false } = Astro.props
---

<header
  id="site-header"
  data-reveal={revealOnScroll ? 'true' : undefined}
  class="sticky top-0 z-50 bg-black "
>
  <div class="
  mx-auto max-w-5xl sm:px-6 xl:max-w-6xl 2xl:max-w-[88rem] min-[1800px]:max-w-[104rem]
  flex items-center justify-between px-4 py-5 sm:px-6">
    <a href={base} aria-label="Dunky home" class="shrink-0">
      <img src={`${base}logo/logo.svg`} alt="Dunky" class="h-8 w-auto invert" />
    </a>
    <nav class="flex items-center gap-6 text-[15px] sm:gap-8">
      <a href={`${base}get-started`} class="text-white/70 transition-colors hover:text-white">Docs</a>
      <a
        href={repo}
        target="_blank"
        rel="noreferrer"
        class="text-white/70 transition-colors hover:text-white">GitHub</a
      >
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="flex h-8 w-8 items-center justify-center rounded text-white/70 transition-colors hover:text-white"
      >
        <!-- sun shows in dark mode, moon in light mode (see style below) -->
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Flip the theme and persist it under Starlight's key so the docs follow.
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('starlight-theme', next)
  })
</script>

<style is:global>
  :root[data-theme='dark'] .theme-icon-moon,
  :root:not([data-theme='dark']) .theme-icon-sun {
    display: none;
  }
</style>

{
  revealOnScroll && (
    <script>
      // Hide the bar over the hero; reveal it (slide down) once the visitor has
      // scrolled past 500px, hide it again when they return to the top.
      const header = document.getElementById('site-header')!
      const THRESHOLD = 72
      let shown = false
      const sync = () => {
        const past = window.scrollY > THRESHOLD
        if (past === shown) return
        shown = past
        header.dataset.shown = String(past)
      }
      sync()
      addEventListener('scroll', sync, { passive: true })
    </script>

    <style is:global>
      /* Reveal-on-scroll header: parked above the viewport until scrolled. */
      #site-header[data-reveal] {
        transition:
          transform 0.28s ease,
          opacity 0.28s ease;
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
      }
      #site-header[data-reveal][data-shown='true'] {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
      }
    </style>
  )
}
