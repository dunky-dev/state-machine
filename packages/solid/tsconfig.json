{
  // Solid 2.0 moved the web JSX namespace out of `solid-js` into `@solidjs/web`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["src", "tests", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
