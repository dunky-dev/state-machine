{
  "name": "@dunky.dev/native-rust",
  "version": "0.0.0",
  "private": true,
  "description": "The Rust engine (crates/uniffi) for React Native, over JSI via uniffi-bindgen-react-native",
  "homepage": "https://github.com/dunky-dev/state-machine/tree/main/packages/native-rust",
  "license": "MIT",
  "author": "Ivan Banov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunky-dev/state-machine.git",
    "directory": "packages/native-rust"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --and-generate",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --and-generate",
    "ubrn:clean": "rm -rf android build cpp ios src/generated NativeRust.podspec"
  },
  "dependencies": {
    "@dunky.dev/state-machine-wasm": "workspace:*",
    "@sandbox/cmdk-core": "workspace:*",
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "NativeRustSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "dev.dunky.nativerust"
    }
  }
}
