{
  "name": "@sandbox/uniffi",
  "version": "0.0.0",
  "private": true,
  "description": "The sandbox palette in Rust (crates/uniffi) as a React Native turbo module, generated by uniffi-bindgen-react-native.",
  "homepage": "https://github.com/dunky-dev/state-machine",
  "license": "MIT",
  "author": "Dunky",
  "repository": {
    "url": "https://github.com/dunky-dev/state-machine"
  },
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "scripts": {
    "ubrn:ios": "ubrn build ios --sim-only --release --and-generate",
    "ubrn:clean": "rm -rf cpp ios android src/Native* src/index.tsx src/generated *.podspec"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "DunkyUniffiSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "dev.dunky.uniffi"
    }
  }
}
